<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- namespace는 매퍼 인터페이스의 전체 이름과 같아야 한다. 다르면 기동은 되고 호출할 때 BindingException이 난다. -->
<mapper namespace="com.example.board.post.PostQueryMapper">

    <select id="findLatestIds" resultType="long">
        SELECT id
        FROM post
        WHERE status = 'ACTIVE'
        ORDER BY id DESC
        LIMIT #{limit}
    </select>
</mapper>
