<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.board.point.PointHistoryMapper">

    <!-- idx_point_ledger_member_id(member_id, id)로 정렬 없이 id 역순을 읽는다. -->
    <select id="findByMember" resultType="com.example.board.point.PointHistoryItem">
        SELECT id, type, amount, balance_after, ref_type, ref_id, created_at
        FROM point_ledger
        <where>
            member_id = #{memberId}
            <if test="afterId != null">
                AND id &lt; #{afterId}
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{limit}
    </select>
</mapper>
