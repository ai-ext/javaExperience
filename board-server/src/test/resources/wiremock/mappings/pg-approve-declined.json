{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/pg/v1/payments",
    "bodyPatterns": [{ "matchesJsonPath": "$[?(@.amount == 999000)]" }]
  },
  "response": {
    "status": 400,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "code": "REJECTED", "message": "한도 초과(모의: 금액 999000은 항상 거절)" }
  }
}
