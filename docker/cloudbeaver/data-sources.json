    "javaexperience-community": {
      "provider": "mysql",
      "driver": "mysql8",
      "name": "community (시나리오)",
      "save-password": true,
      "configuration": {
        "host": "mysql",
        "port": "3306",
        "database": "community",
        "url": "jdbc:mysql://mysql:3306/community",
        "configurationType": "MANUAL",
