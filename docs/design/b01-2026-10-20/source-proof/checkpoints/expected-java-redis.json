  "redis": {
    "checks": [
      "extra-local-vs-shared-threshold40",
      "extra-lua-runtime-error-does-not-undo-incr",
      "extra-split-incr-without-expire-leaves-key",
      "private-redis-probe-keys-explicit-cleanup",
