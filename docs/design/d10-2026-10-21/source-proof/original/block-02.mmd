erDiagram
    COURSE ||--o{ OFFERING : 개설
    STUDENT ||--o{ ENROLLMENT : 신청
    OFFERING ||--o{ ENROLLMENT : 포함
    STUDENT {
        bigint id PK
        varchar campus_no UK
        varchar email UK
        varchar name
    }
    COURSE {
        bigint id PK
        varchar course_code UK
        varchar title
    }
    OFFERING {
        bigint id PK
        bigint course_id FK
        varchar term_code
        smallint section_no
    }
    ENROLLMENT {
        bigint student_id PK, FK
        bigint offering_id PK, FK
        timestamptz enrolled_at
        varchar status
    }
