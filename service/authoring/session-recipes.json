    {
      "id": "session-lab:login",
      "label": "CSRF 검증과 session id 회전으로 로그인",
      "project": "project-v1",
      "method": "POST",
      "path": "/api/v1/session/login",
      "pathParams": {},
      "query": {},
      "headers": { "Content-Type": "application/json", "X-CSRF-Token": "" },
      "bodyKind": "json",
      "body": { "email": "session-lab@example.com", "password": "" },
      "credentials": "include",
      "requiresCookie": true,
      "requiresCsrfToken": true,
      "expected": {
        "statuses": [200],
        "bodyMode": "json",
        "description": "정상 로그인은 회원 id N을 저장하고 응답에 비밀번호·해시를 포함하지 않는다. 로그인 전후 session id가 바뀌어야 한다. 원문은 응답 JSON의 전체 필드 모양을 지정하지 않는다.",
        "fields": [],
        "assertions": [],
        "assertionSupport": { "httpStatus": "automatic", "jsonBody": "manual", "cookieRotation": "manual" }
      },
      "sourceCases": [
        { "id": "session-lab:login:csrf-missing", "label": "CSRF 헤더 누락", "expected": { "statuses": [403], "bodyMode": "any", "description": "비밀번호 검사를 시작하지 않고 인증 상태를 바꾸지 않는다." } },
        { "id": "session-lab:login:csrf-mismatch", "label": "CSRF 토큰 불일치", "expected": { "statuses": [403], "bodyMode": "any", "description": "인증 상태를 바꾸지 않는다." } },
        { "id": "session-lab:login:bad-credentials", "label": "없는 이메일 또는 틀린 비밀번호", "expected": { "statuses": [401], "bodyMode": "any", "description": "없는 이메일과 틀린 비밀번호는 같은 문구다." } }
      ],
      "prepare": ["먼저 GET /api/v1/session/csrf로 받은 익명 session cookie와 csrfToken을 사용한다.", "10-3에서 만든 session-lab@example.com 계정의 실제 비밀번호를 직접 입력한다."],
      "manualBindings": [
        { "name": "JSESSIONID", "location": "cookie", "source": "GET /api/v1/session/csrf의 응답 cookie jar", "required": true },
        { "name": "csrfToken", "location": "header", "source": "GET /api/v1/session/csrf의 응답 body", "required": true },
        { "name": "password", "location": "body", "source": "학습자가 10-3 가입에 사용한 비밀번호", "required": true }
      ],
      "needsInput": ["JSESSIONID", "csrfToken", "password"],
      "manualObservations": [
        { "name": "N", "source": "POST /api/v1/users의 실제 응답 id", "compareWith": "로그인 응답 회원 id와 GET /me 응답 id", "persistence": "none" }
      ],
      "manualCapture": ["로그인 전·후 session id를 로컬 cookie jar에서 비교한다.", "응답 회원 id가 실제 가입 id N과 같은지 확인한다.", "session id와 csrfToken을 저장하지 않는다."],
      "sourceRefs": [
