        "description": "원문은 익명 세션에 무작위 csrfToken을 만들고 응답하며 JSESSIONID cookie로 이어진다고 설명한다. 정확한 HTTP 상태 코드는 정하지 않는다.",
        "fields": ["csrfToken"],
        "assertions": [],
        "assertionSupport": { "httpStatus": "unavailable", "jsonBody": "manual" }
      },
      "sourceCases": [],
