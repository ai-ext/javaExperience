          "sourceUnits": [
            "legacy:10-1",
            "legacy:10-2"
          ],
          "brief": {
            "purpose": "spec-board 전용 DB·Flyway·공통 응답을 실행 확인해 커뮤니티 과정과 다른 project 설정 경계를 세운다.",
            "task": "별도 application 설정을 확인하고 GET /api/v1/health 및 없는 route의 status와 ApiResponse envelope를 대조한다.",
            "preconditions": [
              "legacy 10장 spec-board용 project DB를 사용한다. community-board DB·application.yml과 합치지 않는다.",
              "10-1/10-2의 실제 health 경로·Flyway 설정·오류 envelope를 확인한다."
            ],
            "scenario": [
              {
                "start": "앱 시작 전 datasource DB명과 flyway_schema_history version을 기록한다.",
                "action": "spec-board를 띄우고 GET /api/v1/health와 원문 없는 경로 GET /api/v1/no-such-path를 요청한다.",
                "result": "health 성공은 {status,message,data}; route 실패는 {status,message,code,errors,data:null} 형식으로 구분된다.",
                "after": "서버 재기동 후 같은 health와 schema version을 다시 확인한다."
              }
            ],
            "data": [
              {
                "name": "spec-board datasource와 project schema",
                "reason": "다른 project의 연결을 잘못 검사하지 않도록 한다."
              },
              {
                "name": "Flyway migration version",
                "reason": "재기동 때 적용된 스키마와 데이터 호환을 추적한다."
              },
              {
                "name": "ApiResponse / ErrorCode 응답 필드",
                "reason": "HTTP 상태와 envelope의 의미를 함께 확인한다."
              }
            ],
            "policies": [
              "10장 success/error는 ApiResponse wrapper다. course spec-v2의 ProblemDetail 계약을 섞지 않는다.",
              "실패는 controller 개별 try/catch 대신 전역 advice가 공통 에러 틀로 바꾸는지 확인한다.",
              "spec-board 전용 DB만 사용한다. migration SQL을 적용한 뒤 schema version을 보존한다."
            ],
            "inputs": [
              "GET /api/v1/health.",
              "GET /api/v1/no-such-path.",
              "비교로 Flyway history와 project datasource명을 읽는다."
            ],
