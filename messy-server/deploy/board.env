# 운영 서버 환경 변수. 배포 때 /etc/board/board.env로 복사되고 systemd 유닛이 EnvironmentFile로 읽는다.
# 비밀값(DB_PASSWORD, BOARD_JWT_SECRET, BOARD_PG_SECRET)은 여기 두지 않는다. 배포 파이프라인이 시크릿 저장소에서 넣는다.
SPRING_PROFILES_ACTIVE=prod

DB_URL=jdbc:mysql://board-db.internal:3306/board
DB_USERNAME=board

REDIS_HOST=board-redis.internal
REDIS_PORT=6379

BOARD_PG_BASE_URL=https://pg-gateway.internal

# 모바일 앱 "로그인 유지" 요청(2026-06)으로 토큰 만료를 2시간으로 늘림. 앱 자동 갱신이 붙으면 되돌린다.
BOARD_JWT_EXPIRESINSECONDS=7200
