+package com.example.board.post;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+
+import org.apache.ibatis.session.SqlSessionFactory;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+
+import com.example.board.ApiTestSupport;
+import com.example.board.MyBatisQueryCounter;
+import com.example.board.member.Role;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+
+/** TTL이 끝난 순간 동시 요청이 모두 DB로 몰리는 스탬피드를 막는다. */
+class PopularPostStampedeTest extends ApiTestSupport {
+
+    @Autowired
+    SqlSessionFactory sqlSessionFactory;
+
+    @Test
+    void 캐시가_빈_순간_동시_100요청에도_DB_조회는_1번이다() throws Exception {
+        clearPosts();
+        newPost(newMember(Role.USER));
+        MyBatisQueryCounter queries = MyBatisQueryCounter.attach(sqlSessionFactory);
+        queries.clear();
+
+        ExecutorService pool = Executors.newFixedThreadPool(100);
+        CountDownLatch start = new CountDownLatch(1);
+        List<Future<Integer>> futures = new ArrayList<>();
+        try {
+            for (int i = 0; i < 100; i++) {
+                futures.add(pool.submit(() -> {
+                    start.await();
+                    return mockMvc.perform(get("/api/posts/popular")).andReturn().getResponse().getStatus();
+                }));
+            }
+            start.countDown();
+            for (Future<Integer> f : futures) {
+                assertThat(f.get(30, TimeUnit.SECONDS)).isEqualTo(200);
+            }
+        } finally {
+            pool.shutdown();
+            pool.awaitTermination(30, TimeUnit.SECONDS);
+        }
+
+        assertThat(queries.count("findPopular")).isEqualTo(1);
+    }
+}
