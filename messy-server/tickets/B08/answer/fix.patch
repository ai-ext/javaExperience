diff --git a/src/main/java/com/example/board/member/MemberResponse.java b/src/main/java/com/example/board/member/MemberResponse.java
new file mode 100644
index 0000000..6c0a8ae
--- /dev/null
+++ b/src/main/java/com/example/board/member/MemberResponse.java
@@ -0,0 +1,16 @@
+package com.example.board.member;
+
+import java.time.OffsetDateTime;
+import java.time.ZoneId;
+
+/** 내 정보 응답(spec-v2). 엔티티를 그대로 내보내면 passwordHash·잔액·수정 시각까지 실리므로 응답 전용으로 둔다. */
+public record MemberResponse(Long id, String email, String nickname, Role role, OffsetDateTime createdAt) {
+
+    private static final ZoneId KST = ZoneId.of("Asia/Seoul");
+
+    public static MemberResponse from(Member member) {
+        // 저장은 KST 기준 LocalDateTime이라 오프셋을 붙여 ISO-8601로 내보낸다
+        return new MemberResponse(member.getId(), member.getEmail(), member.getNickname(), member.getRole(),
+                member.getCreatedAt().atZone(KST).toOffsetDateTime());
+    }
+}
