@@ -0,0 +1,90 @@
+package com.example.board.point;
+
+import java.time.Clock;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.ZoneId;
+import java.time.ZoneOffset;
+import java.util.concurrent.atomic.AtomicReference;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.TestConfiguration;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Primary;
+
+import com.example.board.ApiTestSupport;
+import com.example.board.common.BusinessException;
+import com.example.board.member.Member;
+import com.example.board.member.Role;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+/** 서버 시계는 운영처럼 UTC 영역. 출석 날짜는 KST로 잘라야 한다. */
+class AttendanceServiceTest extends ApiTestSupport {
+
+    static final ZoneId KST = ZoneId.of("Asia/Seoul");
+    static final AtomicReference<Instant> NOW = new AtomicReference<>(Instant.now());
+
+    @TestConfiguration(proxyBeanMethods = false)
+    static class ClockConfig {
+        @Bean
+        @Primary
+        Clock fixedUtcClock() {
+            return new Clock() {
+                @Override
+                public ZoneId getZone() {
+                    return ZoneOffset.UTC;
+                }
+
+                @Override
+                public Clock withZone(ZoneId zone) {
+                    return Clock.fixed(NOW.get(), zone);
+                }
+
+                @Override
+                public Instant instant() {
+                    return NOW.get();
+                }
+            };
+        }
+    }
+
+    @Autowired
+    AttendanceService attendanceService;
+
+    static void at(String kst) {
+        NOW.set(LocalDateTime.parse(kst).atZone(KST).toInstant());
+    }
+
+    long attendanceCount(Member m) {
+        return jdbc.queryForObject("SELECT COUNT(*) FROM point_ledger WHERE member_id = ? AND ref_type = 'ATTENDANCE'",
+                Long.class, m.getId());
+    }
+
+    @Test
+    void KST_23시59분59초와_00시는_다른_날이라_각각_적립된다() {
+        Member m = newMember(Role.USER);
+
+        at("2026-10-23T23:59:59");
+        assertThat(attendanceService.attend(m.getId()).attendedOn()).isEqualTo(LocalDate.of(2026, 10, 23));
+        at("2026-10-24T00:00:00");
+        assertThat(attendanceService.attend(m.getId()).attendedOn()).isEqualTo(LocalDate.of(2026, 10, 24));
+
+        assertThat(attendanceCount(m)).isEqualTo(2);
+    }
+
+    @Test
+    void UTC_자정인_KST_09시_앞뒤는_같은_날이라_한_번만_적립된다() {
+        Member m = newMember(Role.USER);
+
+        at("2026-10-23T08:59:59");
+        attendanceService.attend(m.getId());
+        at("2026-10-23T09:00:00");
+        assertThatThrownBy(() -> attendanceService.attend(m.getId())).isInstanceOf(BusinessException.class);
+
+        assertThat(attendanceCount(m)).isEqualTo(1);
+    }
+}
