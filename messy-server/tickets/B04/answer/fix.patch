 package com.example.board.notification;
 
+import java.util.Set;
+
+import static com.example.board.notification.NotificationChannel.EMAIL;
+import static com.example.board.notification.NotificationChannel.IN_APP;
+import static com.example.board.notification.NotificationChannel.PUSH;
+
+/** 알림 종류와 그 종류를 내보낼 채널. 채널을 더하면 여기와 새 NotificationSender 하나만 고친다. */
 public enum NotificationType {
-    POST_CREATED, POST_DELETED, COMMENT_ADDED
+    POST_CREATED(Set.of(IN_APP, PUSH)),
+    POST_DELETED(Set.of(IN_APP, EMAIL)),
+    COMMENT_ADDED(Set.of(IN_APP, PUSH, EMAIL));
+
+    private final Set<NotificationChannel> channels;
+
+    NotificationType(Set<NotificationChannel> channels) {
+        this.channels = channels;
+    }
+
+    public boolean sendsTo(NotificationChannel channel) {
+        return channels.contains(channel);
+    }
 }
