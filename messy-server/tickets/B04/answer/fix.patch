+++ b/src/main/java/com/example/board/notification/PushNotificationSender.java
@@ -0,0 +1,34 @@
+package com.example.board.notification;
+
+import org.springframework.stereotype.Component;
+
+/** 앱 푸시 대기열. 잠금 화면에 두 줄만 보이므로 본문을 40자로 자른다. */
+@Component
+public class PushNotificationSender implements NotificationSender {
+
+    static final int MAX_BODY = 40;
+
+    private final NotificationRepository repository;
+
+    public PushNotificationSender(NotificationRepository repository) {
+        this.repository = repository;
+    }
+
+    @Override
+    public NotificationChannel channel() {
+        return NotificationChannel.PUSH;
+    }
+
+    @Override
+    public void send(NotificationMessage m) {
+        repository.save(Notification.create(m.recipientId(), channel(), m.type(), m.title(), shorten(m.body()),
+                m.refId()));
+    }
+
+    private static String shorten(String body) {
+        if (body.codePointCount(0, body.length()) <= MAX_BODY) {
+            return body;
+        }
+        return body.substring(0, body.offsetByCodePoints(0, MAX_BODY - 1)) + "…";
+    }
+}
